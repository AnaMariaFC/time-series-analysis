# Calcular a média:
tempo_horas <- (1:length(serieHeartRate))/3600
plot(tempo_horas[1:5000],
serieHeartRate[1:5000],
type = "l",
main = "Série Temporal da Frequência Cardíaca",
ylab = "HR",
xlab = "Tempo (horas)")
