# Calculando a média móvel:
media_movel <- filter(serieHeartRate,
rep(1/500, 500),
sides = 2)
plot(serieHeartRate,
type = "l",
main = "Série Temporal com Média Móvel",
ylab = "HR",
xlab = "Tempo")
