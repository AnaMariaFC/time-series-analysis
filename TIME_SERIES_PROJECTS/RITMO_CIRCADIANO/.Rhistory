# Instalar e carregar o pacote, caso não tenha
# install.packages("forecast")
library(forecast)
# 1. Criar uma série temporal fictícia (Simulando o seu PIB Trimestral)
# Supondo que seus dados comecem em 1950, 1º trimestre (frequency = 4 para trimestral)
dados_pib <- c(20000, 20100, 20150, 20300, 20400, 20600) # substitua pelos seus dados reais
pib_ts <- ts(dados_pib, start = c(1950, 1), frequency = 4)
# 2. Ajustar o modelo automaticamente com a função ets()
# O ets() vai decidir sozinho se usa Holt, Holt-Winters ou Simples
modelo_automatico <- ets(pib_ts)
# Ver o resumo do modelo escolhido (valores de alfa, beta, gama, etc.)
summary(modelo_automatico)
# Previsão dos próximos 8 trimestres
previsao_holt <- forecast(modelo_holt, h = 8)
plot(previsao_holt,
main="Previsão do PIB per capita usando Holt")
summary(modelo_holt)
plot(previsao_holt,
main = "Previsão do PIB per capita pelo método de Holt",
xlab = "Tempo",
ylab = "PIB per capita")
